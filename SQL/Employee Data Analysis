    emp_id INTEGER PRIMARY KEY,
    f_name TEXT NOT NULL,
    l_name TEXT NOT NULL,
    job_id TEXT NOT NULL,
    salary REAL NOT NULL,
    manager_id TEXT,
    dept_id INTEGER
);

