SELECT e.f_name, e.l_name
FROM employee AS e
JOIN employee AS calvin
    ON e.salary > calvin.salary
WHERE calvin.job_id = 'CM345';



SELECT emp_id, f_name
FROM (
    SELECT emp_id, f_name, salary
    FROM employee

    EXCEPT

    SELECT emp_id, f_name, salary
    FROM employee
    WHERE salary <= (
        SELECT salary
        FROM employee
        WHERE job_id = 'MW789'
    )
) AS higher_earners
ORDER BY salary DESC;


SELECT e.f_name, e.emp_id, e.salary
FROM employee AS e
JOIN (
    SELECT emp_id
    FROM employee
    ORDER BY salary DESC
    LIMIT 3
) AS top_earners
    ON e.emp_id = top_earners.emp_id
ORDER BY e.salary DESC;
